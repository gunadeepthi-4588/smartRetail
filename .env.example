# ==============================================================================
# SmartRetail — Root Environment Configuration Template
# Copy this file to .env before running the application locally.
# NEVER commit the real .env file or real secrets to version control.
# ==============================================================================

# Backend Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_key_in_production
PORT=5000

# MySQL Database Settings (Configuration used from Phase 3 onward)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_retail_db

# Frontend Settings
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_PORT=5173
VITE_APP_NAME="SmartRetail"
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_CURRENCY_SYMBOL="₹"
