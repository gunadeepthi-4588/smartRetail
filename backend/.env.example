# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key
PORT=5000

# Managed MySQL Database Configuration (Aiven / TiDB / Render / Railway / AWS RDS)
DB_HOST=your-cloud-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=smart_retail_db
# SSL Options: Set DB_SSL_MODE=REQUIRED for Aiven/TiDB/Cloud databases, or provide DB_SSL_CA path
DB_SSL_MODE=REQUIRED
# DB_SSL_CA=/path/to/ca-certificate.pem


# CORS Security (Comma-separated list of deployed frontend URLs)
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Store Level Defaults
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_SAFETY_STOCK_DAYS=7
DEFAULT_LEAD_TIME_DAYS=3
